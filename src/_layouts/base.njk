<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} | {% endif %}Woven Web</title>
  <meta name="description" content="{{ description or 'Woven Web — a community research lab weaving education, arts, and technology in service of life.' }}">
  {% if canonical %}<link rel="canonical" href="{{ canonical }}">{% endif %}
  <meta name="theme-color" content="#EDEBE3" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#12173A" media="(prefers-color-scheme: dark)">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/fonts/newsreader-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/style.css?v={{ build }}">
</head>
<body class="{{ bodyClass or 'page' }}">
  {% if not home %}
  <header class="site-header">
    <a href="/" class="site-header__home">Woven Web</a>
  </header>
  {% endif %}
  <main>
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <p class="site-footer__quote">The web already holds us.</p>
    <div class="site-footer__links">
      <a href="mailto:hello@wovenweb.org">Email</a>
      <a href="https://github.com/Woven-Web">GitHub</a>
    </div>
  </footer>
  {% if home %}<script src="/js/web.js?v={{ build }}" type="module"></script>{% endif %}
</body>
</html>
